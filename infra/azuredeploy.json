      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Image generation (lab 39). Some image models need an access request; enable after approval."
      }
    },
    "imageModel": {
      "type": "string",
      "defaultValue": "gpt-image-1-mini"
    },
    "imageModelVersion": {
      "type": "string",
      "defaultValue": "2025-10-06"
    },
    "deployVideoModel": {
      "type": "bool",
      "defaultValue": false,
