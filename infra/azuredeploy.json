    "imageDeployments": "[if(parameters('deployImageModel'), createArray(createObject('name', parameters('imageModel'), 'model', parameters('imageModel'), 'version', parameters('imageModelVersion'), 'sku', 'GlobalStandard', 'capacity', 1)), createArray())]",
    "videoDeployments": "[if(parameters('deployVideoModel'), createArray(createObject('name', parameters('videoModel'), 'model', parameters('videoModel'), 'version', parameters('videoModelVersion'), 'sku', 'GlobalStandard', 'capacity', 1)), createArray())]",
