    "chatModel": {
      "type": "string",
      "defaultValue": "gpt-5.4-mini"
    },
    "chatModelVersion": {
      "type": "string",
      "defaultValue": "2026-03-17"
    },
    "chatCapacity": {
      "type": "int",
      "defaultValue": 50
    },
    "smallModel": {
      "type": "string",
      "defaultValue": "gpt-5.4-nano"
