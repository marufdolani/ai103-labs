    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "1"
    },
    "embeddingCapacity": {
      "type": "int",
      "defaultValue": 50
    },
    "deployModelRouter": {
      "type": "bool",
      "defaultValue": true
    },
    "modelRouterVersion": {
      "type": "string",
      "defaultValue": "2025-11-18"
