    "legacyDeployments": "[if(parameters('deployLegacyChat'), createArray(createObject('name', 'gpt-4.1-mini', 'model', 'gpt-4.1-mini', 'version', '2025-04-14', 'sku', 'GlobalStandard', 'capacity', 30)), createArray())]",
