      "type": "string",
      "defaultValue": "gpt-5.2",
      "metadata": {
        "description": "Large multimodal model. Also the default Content Understanding completion model and evaluation judge."
      }
    },
    "largeModelVersion": {
      "type": "string",
      "defaultValue": "2025-12-11"
    },
    "largeCapacity": {
      "type": "int",
      "defaultValue": 30
    },
    "embeddingModel": {
      "type": "string",
      "defaultValue": "text-embedding-3-large"
